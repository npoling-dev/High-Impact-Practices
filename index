<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TAMU High-Impact Practices (HIPs) Course Profile Tool</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @media print {
            body * {
                visibility: hidden;
            }
            #printable-report, #printable-report * {
                visibility: visible;
            }
            #printable-report {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                margin: 0;
                padding: 20px;
                box-shadow: none !important;
                border: none !important;
            }
            .no-print {
                display: none !important;
            }
        }
        .bg-matrix-cell {
            background-color: #f1f5f9;
        }
        .bg-tamu-maroon {
            background-color: #500000;
        }
        .text-tamu-maroon {
            color: #500000;
        }
        .border-tamu-maroon {
            border-color: #500000;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-tamu-maroon text-white shadow-md no-print">
        <div class="max-w-7xl mx-auto px-4 py-6 flex flex-col md:flex-row justify-between items-center gap-4">
            <div>
                <div class="flex items-center gap-2">
                    <i data-lucide="award" class="w-8 h-8 text-amber-400"></i>
                    <h1 class="text-2xl font-bold tracking-tight">Texas A&M University</h1>
                </div>
                <p class="text-slate-200 text-sm mt-1">High-Impact Practices (HIPs) Course Profile & Design Tool</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="bg-amber-400 text-slate-900 text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider">
                    All 4 Quadrants • 8 AAC&U Elements
                </span>
            </div>
        </div>
    </header>

    <!-- Navigation Tabs -->
    <nav class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm no-print">
        <div class="max-w-7xl mx-auto px-4 flex space-x-1 sm:space-x-4 overflow-x-auto">
            <button onclick="switchTab('matrix')" id="tab-btn-matrix" class="tab-btn py-4 px-3 sm:px-4 text-sm font-medium border-b-2 border-tamu-maroon text-tamu-maroon flex items-center gap-2 whitespace-nowrap">
                <i data-lucide="grid" class="w-4 h-4"></i> 1. HIP Matrix & Exemplars
            </button>
            <button onclick="switchTab('diagnostic')" id="tab-btn-diagnostic" class="tab-btn py-4 px-3 sm:px-4 text-sm font-medium border-b-2 border-transparent text-slate-600 hover:text-slate-900 flex items-center gap-2 whitespace-nowrap">
                <i data-lucide="check-circle-2" class="w-4 h-4"></i> 2. Self-Assessment Diagnostic (24 pts)
            </button>
            <button onclick="switchTab('syllabus')" id="tab-btn-syllabus" class="tab-btn py-4 px-3 sm:px-4 text-sm font-medium border-b-2 border-transparent text-slate-600 hover:text-slate-900 flex items-center gap-2 whitespace-nowrap">
                <i data-lucide="file-text" class="w-4 h-4"></i> 3. Syllabus Language Builder
            </button>
            <button onclick="switchTab('scaffolding')" id="tab-btn-scaffolding" class="tab-btn py-4 px-3 sm:px-4 text-sm font-medium border-b-2 border-transparent text-slate-600 hover:text-slate-900 flex items-center gap-2 whitespace-nowrap">
                <i data-lucide="sliders" class="w-4 h-4"></i> 4. Profile Report & Scaffolding (Phase 1 & 2)
            </button>
        </div>
    </nav>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 py-8 flex-1 w-full">

        <!-- TAB 1: MATRIX & EXEMPLARS -->
        <section id="tab-matrix" class="tab-content">
            <div class="mb-6 bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <h2 class="text-xl font-bold text-slate-900 mb-2 flex items-center gap-2">
                    <i data-lucide="layers" class="w-5 h-5 text-tamu-maroon"></i>
                    Interactive Quality Framework Matrix
                </h2>
                <p class="text-slate-600 text-sm">
                    Explore high-impact instructional practices mapped across all 4 AAC&U Quadrants and 3 Scope Levels. Click any cell to view 3 realistic, discipline-specific exemplars with TAMU Undergraduate Learning Outcome (ULO) mappings.
                </p>
            </div>

            <!-- Matrix Table -->
            <div class="overflow-x-auto bg-white rounded-xl border border-slate-200 shadow-sm mb-8">
                <table class="w-full text-left text-sm border-collapse">
                    <thead>
                        <tr class="bg-slate-100 border-b border-slate-200">
                            <th class="p-4 font-bold text-slate-700 w-1/5">Quadrant & Quality Element</th>
                            <th class="p-4 font-bold text-slate-700 text-center w-1/4">Foundational</th>
                            <th class="p-4 font-bold text-slate-700 text-center w-1/4">Applied</th>
                            <th class="p-4 font-bold text-slate-700 text-center w-1/4">Integrated</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200" id="matrix-tbody">
                        <!-- Populated by JS -->
                    </tbody>
                </table>
            </div>
        </section>

        <!-- TAB 2: DIAGNOSTIC TOOL -->
        <section id="tab-diagnostic" class="tab-content hidden">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Left: Assessment Form -->
                <div class="lg:col-span-2 space-y-6">
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                        <h2 class="text-xl font-bold text-slate-900 mb-2 flex items-center gap-2">
                            <i data-lucide="check-square" class="w-5 h-5 text-tamu-maroon"></i>
                            Course Fidelity Self-Assessment (24 Points Max)
                        </h2>
                        <p class="text-slate-600 text-sm">
                            Evaluate your course against all 8 AAC&U High-Impact Quality Elements. Select the fidelity level (0–3 points) that best represents your current or planned course design.
                        </p>
                    </div>

                    <div class="space-y-4" id="diagnostic-questions">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Right: Real-time Score Panel -->
                <div class="lg:col-span-1">
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm sticky top-24">
                        <h3 class="text-lg font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100">Fidelity Scorecard</h3>
                        
                        <div class="text-center py-4 bg-slate-50 rounded-xl mb-6">
                            <div class="text-5xl font-extrabold text-tamu-maroon" id="total-score">0</div>
                            <div class="text-xs text-slate-500 font-semibold mt-1">OUT OF 24 POINTS</div>
                            <div class="mt-3 inline-block px-3 py-1 rounded-full text-xs font-bold" id="score-badge">Developing</div>
                        </div>

                        <h4 class="text-sm font-bold text-slate-700 mb-2">Mapped TAMU ULO Badges</h4>
                        <div class="flex flex-wrap gap-1.5 mb-6" id="ulo-badges-container">
                            <!-- Populated dynamically -->
                        </div>

                        <button onclick="switchTab('scaffolding')" class="w-full bg-tamu-maroon hover:bg-red-900 text-white font-semibold py-2.5 px-4 rounded-lg shadow text-sm transition flex items-center justify-center gap-2">
                            <i data-lucide="file-output" class="w-4 h-4"></i> View & Print Summary Report
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 3: SYLLABUS BUILDER -->
        <section id="tab-syllabus" class="tab-content hidden">
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm mb-6">
                <h2 class="text-xl font-bold text-slate-900 mb-2 flex items-center gap-2">
                    <i data-lucide="file-code" class="w-5 h-5 text-tamu-maroon"></i>
                    Syllabus Language Generator
                </h2>
                <p class="text-slate-600 text-sm">
                    Select an AAC&U Element and desired Scope Level to generate copy-paste syllabus modules mapped to TAMU Undergraduate Learning Outcomes (ULOs).
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Controls -->
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Select AAC&U Element</label>
                        <select id="syllabus-element-select" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-tamu-maroon focus:outline-none">
                            <!-- Options populated by JS -->
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Select Scope Level</label>
                        <select id="syllabus-level-select" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-tamu-maroon focus:outline-none">
                            <option value="Foundational">Foundational</option>
                            <option value="Applied">Applied</option>
                            <option value="Integrated">Integrated</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Discipline Track</label>
                        <select id="syllabus-track-select" class="w-full p-2.5 border border-slate-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-tamu-maroon focus:outline-none">
                            <option value="STEM">STEM Track</option>
                            <option value="Non-STEM">Non-STEM Track</option>
                            <option value="Co-Curricular">Co-Curricular Track</option>
                        </select>
                    </div>
                    <button onclick="generateSyllabusLanguage()" class="w-full bg-tamu-maroon text-white font-semibold py-2.5 rounded-lg hover:bg-red-900 transition text-sm flex items-center justify-center gap-2">
                        <i data-lucide="sparkles" class="w-4 h-4"></i> Generate Statement
                    </button>
                </div>

                <!-- Output Box -->
                <div class="md:col-span-2 bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="font-bold text-slate-900">Generated Syllabus Text</h3>
                            <button onclick="copySyllabusText()" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-1.5 px-3 rounded flex items-center gap-1 border border-slate-300">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i> Copy to Clipboard
                            </button>
                        </div>
                        <div id="syllabus-output" class="bg-slate-50 p-4 rounded-lg border border-slate-200 text-slate-700 text-sm leading-relaxed min-h-[220px] whitespace-pre-wrap font-mono">
Click "Generate Statement" to preview ready-to-use syllabus language formatted for Texas A&M course outlines.
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 4: PHASE 1 & PHASE 2 (PROFILE REPORT & IMPLEMENTATION SCAFFOLDING) -->
        <section id="tab-scaffolding" class="tab-content hidden space-y-10">
            
            <!-- PHASE 1: EXPANDED HIP COURSE PROFILE REPORT -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 sm:p-8" id="printable-report">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-6 border-b border-slate-200">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="bg-tamu-maroon text-white text-xs font-bold px-2.5 py-1 rounded">PHASE 1 DELIVERABLE</span>
                            <span class="text-xs font-semibold text-slate-500">Official Profile Summary</span>
                        </div>
                        <h2 class="text-2xl font-bold text-slate-900 mt-2">Texas A&M HIP Course Profile Report</h2>
                        <p class="text-slate-600 text-sm">Documentation for Peer Review, P&T Dossiers, & Curriculum Committees.</p>
                    </div>
                    <button onclick="window.print()" class="no-print bg-tamu-maroon hover:bg-red-900 text-white font-semibold px-4 py-2 rounded-lg text-sm flex items-center gap-2 shadow">
                        <i data-lucide="printer" class="w-4 h-4"></i> Print / Export PDF
                    </button>
                </div>

                <!-- Course Meta Info Form (Editable) -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6 no-print">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Course Code & Name</label>
                        <input type="text" id="report-course-name" value="ENGR 482 / COMM 305" class="w-full p-2 text-sm border rounded border-slate-300">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Instructor / Lead</label>
                        <input type="text" id="report-instructor" value="Dr. Faculty Member" class="w-full p-2 text-sm border rounded border-slate-300">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Academic Unit / Dept</label>
                        <input type="text" id="report-dept" value="College of Engineering / Liberal Arts" class="w-full p-2 text-sm border rounded border-slate-300">
                    </div>
                </div>

                <!-- Printable Metadata Summary Box -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 bg-slate-50 p-6 rounded-xl border border-slate-200 my-6">
                    <div>
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Overall Fidelity Score</div>
                        <div class="text-3xl font-extrabold text-tamu-maroon mt-1" id="report-score-display">0 / 24 Points</div>
                        <p class="text-xs text-slate-600 mt-1" id="report-status-desc">Calculated based on 8 AAC&U Quality Elements.</p>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Primary Alignment Track</div>
                        <div class="text-lg font-bold text-slate-800 mt-1">Interdisciplinary / Applied</div>
                        <p class="text-xs text-slate-600 mt-1">Integrates academic rigor with experiential application.</p>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">TAMU ULO Coverage</div>
                        <div class="flex flex-wrap gap-1 mt-2" id="report-ulo-list">
                            <!-- Populated by JS -->
                        </div>
                    </div>
                </div>

                <div class="space-y-4">
                    <h3 class="font-bold text-slate-900 border-b pb-2">High-Impact Practice Element Summary</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs" id="report-element-grid">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>

            <!-- PHASE 2: IMPLEMENTATION PITFALLS & SCAFFOLDING ACCORDION -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 sm:p-8">
                <div class="mb-6">
                    <div class="flex items-center gap-2">
                        <span class="bg-amber-500 text-slate-900 text-xs font-bold px-2.5 py-1 rounded">PHASE 2 DELIVERABLE</span>
                        <span class="text-xs font-semibold text-slate-500">Pedagogical Scaffolding & Equity Guide</span>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-900 mt-2">Implementation Pitfalls & Scaffolding Solutions</h2>
                    <p class="text-slate-600 text-sm">Concrete strategies to prevent common course design failures and foster inclusive, high-fidelity execution across all 8 AAC&U elements.</p>
                </div>

                <!-- Accordion List -->
                <div class="space-y-4" id="scaffolding-accordion">
                    <!-- Dynamic accordion populated by JS -->
                </div>
            </div>
        </section>

    </main>

    <!-- Modal for Exemplars -->
    <div id="exemplar-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-xl max-w-3xl w-full max-h-[90vh] overflow-y-auto shadow-2xl border border-slate-200 p-6">
            <div class="flex justify-between items-start pb-4 border-b border-slate-200">
                <div>
                    <span id="modal-quadrant" class="text-xs font-bold text-tamu-maroon uppercase tracking-wider">Quadrant A</span>
                    <h3 id="modal-title" class="text-xl font-bold text-slate-900">Element Title</h3>
                </div>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 p-1">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>

            <div class="py-6 space-y-6" id="modal-body">
                <!-- 3 Exemplars (STEM, Non-STEM, Co-Curricular) populated by JS -->
            </div>

            <div class="pt-4 border-t border-slate-200 flex justify-end">
                <button onclick="closeModal()" class="bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold px-4 py-2 rounded-lg text-sm">
                    Close Window
                </button>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-6 text-center text-xs no-print">
        <p>Texas A&M University High-Impact Practices (HIPs) Framework • Mapped to Texas A&M 7 Undergraduate Learning Outcomes (ULOs)</p>
    </footer>

    <!-- JavaScript Application Logic -->
    <script>
        // AAC&U Elements & Quadrants Data
        const elementsData = [
            { id: 1, quad: "Quadrant A", name: "1. Faculty & Peer Interactions", desc: "Substantive, frequent interactions about academic matters.", ulo: ["Communication", "Collaboration"] },
            { id: 2, quad: "Quadrant A", name: "2. Iterative Feedback & Revision", desc: "Constructive, timely feedback paired with opportunities to refine work.", ulo: ["Critical Thinking", "Lifelong Learning"] },
            { id: 3, quad: "Quadrant B", name: "3. Time & Effort Investment", desc: "Significant time demands over an extended duration.", ulo: ["Depth of Knowledge", "Lifelong Learning"] },
            { id: 4, quad: "Quadrant B", name: "4. High Performance Expectations", desc: "Challenging expectations set clearly at the start.", ulo: ["Depth of Knowledge", "Critical Thinking"] },
            { id: 5, quad: "Quadrant C", name: "5. Real-World Application & Context", desc: "Connecting theory with practical, hands-on environments.", ulo: ["Depth of Knowledge", "Social Responsibility"] },
            { id: 6, quad: "Quadrant C", name: "6. Diversity & Global Perspectives", desc: "Engaging across differences and unfamiliar contexts.", ulo: ["Cultural Competence", "Social Responsibility"] },
            { id: 7, quad: "Quadrant D", name: "7. Structured Reflection & Metacognition", desc: "Periodic opportunities to integrate and evaluate learning.", ulo: ["Critical Thinking", "Lifelong Learning"] },
            { id: 8, quad: "Quadrant D", name: "8. Public Demonstration of Competence", desc: "Showcasing mastery to audiences beyond the classroom.", ulo: ["Communication", "Collaboration"] }
        ];

        // Scaffolding Data (Phase 2)
        const scaffoldingData = [
            {
                element: "1. Faculty & Peer Interactions",
                pitfall: "Students engage in free-riding or superficial peer interactions without meaningful academic debate.",
                solution: "Implement structured group contracts, mandatory peer feedback rubrics, and brief 5-minute biweekly check-ins between faculty and teams.",
                equity: "Offer asynchronous peer review options and flexible virtual office hours for working or commuting students."
            },
            {
                element: "2. Iterative Feedback & Revision",
                pitfall: "Students treat instructor feedback as final grade justifications rather than actionable revision guidance.",
                solution: "Require a 1-page 'Revision Log' accompanying final submissions detailing specific changes made in response to earlier feedback.",
                equity: "Provide transparent rubrics upfront and low-stakes draft submissions to reduce grade anxiety."
            },
            {
                element: "3. Time & Effort Investment",
                pitfall: "Assignment creep causes sudden workload spikes leading to student burnout or missed deadlines.",
                solution: "Map out milestone deadlines across the semester and benchmark out-of-class effort using a 3:1 credit-hour ratio guide.",
                equity: "Utilize low-cost course materials and offer clear grace period policies for unexpected life conflicts."
            },
            {
                element: "4. High Performance Expectations",
                pitfall: "High expectations without clear scaffolding cause student confusion and defensiveness.",
                solution: "Share annotated student exemplars (strong, average, weak) from previous semesters to illustrate high-quality work.",
                equity: "Provide multiple pathways (written, oral, visual) to demonstrate high mastery of core learning objectives."
            },
            {
                element: "5. Real-World Application & Context",
                pitfall: "Real-world projects lack clear boundaries, causing partner friction or unachievable project scopes.",
                solution: "Draft a formal project brief specifying client deliverables, student roles, and realistic time commitments.",
                equity: "Ensure field options are local, zero-cost, or accessible via virtual site visits."
            },
            {
                element: "6. Diversity & Global Perspectives",
                pitfall: "Diverse topics are added tokenistically without meaningful engagement or critical reflection.",
                solution: "Embed structured intercultural frameworks and diverse author panels into core assignments.",
                equity: "Validate non-traditional student backgrounds and lived experiences as valid academic knowledge."
            },
            {
                element: "7. Structured Reflection & Metacognition",
                pitfall: "Reflections devolve into simple 'what I did' logs rather than deep analytical learning.",
                solution: "Structure reflection prompts using the 'WHAT? SO WHAT? NOW WHAT?' model to prompt metacognition.",
                equity: "Allow reflection submissions in multi-modal formats (written essay, audio memo, video journal)."
            },
            {
                element: "8. Public Demonstration of Competence",
                pitfall: "High-stakes public showcases trigger severe performance anxiety or technical failures.",
                solution: "Schedule low-stakes internal practice runs before final public poster sessions, symposia, or client pitches.",
                equity: "Provide alternative public formats (e.g., digital portfolios, asynchronous presentations) when needed."
            }
        ];

        // Diagnostic State
        let diagnosticScores = {};

        // Initialize application
        window.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            renderMatrix();
            renderDiagnostic();
            populateSyllabusOptions();
            renderScaffoldingAccordion();
            updateDiagnosticScore();
        });

        // Tab Switching Logic
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('border-tamu-maroon', 'text-tamu-maroon');
                btn.classList.add('border-transparent', 'text-slate-600');
            });

            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-btn-${tabId}`);
            activeBtn.classList.add('border-tamu-maroon', 'text-tamu-maroon');
            activeBtn.classList.remove('border-transparent', 'text-slate-600');

            if(tabId === 'scaffolding') {
                updateReportView();
            }
        }

        // Render Matrix Table
        function renderMatrix() {
            const tbody = document.getElementById('matrix-tbody');
            tbody.innerHTML = elementsData.map(el => `
                <tr class="hover:bg-slate-100 transition">
                    <td class="p-4 font-semibold text-slate-800 border-r border-slate-200">
                        <span class="text-xs font-bold text-tamu-maroon uppercase block">${el.quad}</span>
                        ${el.name}
                    </td>
                    <td onclick="openExemplarModal('${el.name}', 'Foundational')" class="p-4 border-r border-slate-200 cursor-pointer bg-matrix-cell hover:bg-red-50 transition text-center text-xs font-medium text-slate-700">
                        <div class="font-bold mb-1 text-tamu-maroon">Foundational</div>
                        <span class="text-slate-500">Click to view 3 Exemplars</span>
                    </td>
                    <td onclick="openExemplarModal('${el.name}', 'Applied')" class="p-4 border-r border-slate-200 cursor-pointer bg-matrix-cell hover:bg-red-50 transition text-center text-xs font-medium text-slate-700">
                        <div class="font-bold mb-1 text-tamu-maroon">Applied</div>
                        <span class="text-slate-500">Click to view 3 Exemplars</span>
                    </td>
                    <td onclick="openExemplarModal('${el.name}', 'Integrated')" class="p-4 cursor-pointer bg-matrix-cell hover:bg-red-50 transition text-center text-xs font-medium text-slate-700">
                        <div class="font-bold mb-1 text-tamu-maroon">Integrated</div>
                        <span class="text-slate-500">Click to view 3 Exemplars</span>
                    </td>
                </tr>
            `).join('');
        }

        // Modal Handler
        function openExemplarModal(elementName, level) {
            document.getElementById('modal-title').innerText = `${elementName} (${level} Level)`;
            
            const modalBody = document.getElementById('modal-body');
            modalBody.innerHTML = `
                <div class="border border-slate-200 rounded-lg p-4 bg-slate-50">
                    <div class="flex items-center justify-between mb-2">
                        <span class="bg-blue-100 text-blue-800 text-xs font-bold px-2 py-0.5 rounded">STEM Track</span>
                        <span class="text-xs font-semibold text-slate-500">Mapped ULO: Critical Thinking, Communication</span>
                    </div>
                    <h4 class="font-bold text-slate-800 text-sm mb-1">${level} Lab/Engineering Design Module</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">Students engage in structured technical problem solving with peer code/design reviews, structured milestone feedback, and real-world application briefs.</p>
                </div>

                <div class="border border-slate-200 rounded-lg p-4 bg-slate-50">
                    <div class="flex items-center justify-between mb-2">
                        <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-2 py-0.5 rounded">Non-STEM Track</span>
                        <span class="text-xs font-semibold text-slate-500">Mapped ULO: Social Responsibility, Cultural Competence</span>
                    </div>
                    <h4 class="font-bold text-slate-800 text-sm mb-1">${level} Humanities / Social Science Analysis</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">Students conduct qualitative analysis, participating in biweekly peer workshops, iterative draft revisions, and community-engaged case studies.</p>
                </div>

                <div class="border border-slate-200 rounded-lg p-4 bg-slate-50">
                    <div class="flex items-center justify-between mb-2">
                        <span class="bg-purple-100 text-purple-800 text-xs font-bold px-2 py-0.5 rounded">Co-Curricular Track</span>
                        <span class="text-xs font-semibold text-slate-500">Mapped ULO: Collaboration, Lifelong Learning</span>
                    </div>
                    <h4 class="font-bold text-slate-800 text-sm mb-1">${level} Student Leadership / Internship Practicum</h4>
                    <p class="text-xs text-slate-600 leading-relaxed">Participants manage campus projects, engaging in regular mentor coaching, guided reflection logs, and public showcase posters.</p>
                </div>
            `;

            document.getElementById('exemplar-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('exemplar-modal').classList.add('hidden');
        }

        // Render Diagnostic Form
        function renderDiagnostic() {
            const container = document.getElementById('diagnostic-questions');
            container.innerHTML = elementsData.map(el => {
                diagnosticScores[el.id] = 0;
                return `
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-3">
                        <div class="flex justify-between items-start">
                            <div>
                                <span class="text-xs font-bold text-tamu-maroon uppercase">${el.quad}</span>
                                <h4 class="font-bold text-slate-800 text-base">${el.name}</h4>
                                <p class="text-xs text-slate-500">${el.desc}</p>
                            </div>
                            <span class="text-xs font-bold text-slate-400 bg-slate-100 px-2.5 py-1 rounded-full" id="score-val-${el.id}">0 / 3 pts</span>
                        </div>
                        <div class="grid grid-cols-4 gap-2 text-xs">
                            <button onclick="setScore(${el.id}, 0)" id="btn-${el.id}-0" class="diag-btn p-2 rounded border border-slate-200 bg-tamu-maroon text-white font-medium">0: Absent</button>
                            <button onclick="setScore(${el.id}, 1)" id="btn-${el.id}-1" class="diag-btn p-2 rounded border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 font-medium">1: Foundational</button>
                            <button onclick="setScore(${el.id}, 2)" id="btn-${el.id}-2" class="diag-btn p-2 rounded border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 font-medium">2: Applied</button>
                            <button onclick="setScore(${el.id}, 3)" id="btn-${el.id}-3" class="diag-btn p-2 rounded border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 font-medium">3: Integrated</button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function setScore(elementId, score) {
            diagnosticScores[elementId] = score;
            document.getElementById(`score-val-${elementId}`).innerText = `${score} / 3 pts`;
            
            for(let i=0; i<=3; i++) {
                const btn = document.getElementById(`btn-${elementId}-${i}`);
                if(i === score) {
                    btn.className = "diag-btn p-2 rounded border border-slate-200 bg-tamu-maroon text-white font-medium";
                } else {
                    btn.className = "diag-btn p-2 rounded border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 font-medium";
                }
            }
            updateDiagnosticScore();
        }

        function updateDiagnosticScore() {
            const total = Object.values(diagnosticScores).reduce((a, b) => a + b, 0);
            document.getElementById('total-score').innerText = total;

            const badge = document.getElementById('score-badge');
            if(total >= 18) {
                badge.innerText = "High-Fidelity HIP Course";
                badge.className = "mt-3 inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800";
            } else if(total >= 10) {
                badge.innerText = "Developing HIP Course";
                badge.className = "mt-3 inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800";
            } else {
                badge.innerText = "Emerging Design";
                badge.className = "mt-3 inline-block px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700";
            }

            // Update Badges
            const activeUlos = new Set();
            elementsData.forEach(el => {
                if(diagnosticScores[el.id] > 0) {
                    el.ulo.forEach(u => activeUlos.add(u));
                }
            });

            const ulosContainer = document.getElementById('ulo-badges-container');
            ulosContainer.innerHTML = Array.from(activeUlos).map(u => 
                `<span class="bg-slate-100 border border-slate-300 text-slate-700 text-xs px-2 py-0.5 rounded-full font-medium">${u}</span>`
            ).join('') || '<span class="text-xs text-slate-400">Complete self-assessment to map ULOs</span>';
        }

        // Populate Syllabus Options
        function populateSyllabusOptions() {
            const select = document.getElementById('syllabus-element-select');
            select.innerHTML = elementsData.map(e => `<option value="${e.id}">${e.name}</option>`).join('');
        }

        function generateSyllabusLanguage() {
            const elemId = document.getElementById('syllabus-element-select').value;
            const level = document.getElementById('syllabus-level-select').value;
            const track = document.getElementById('syllabus-track-select').value;
            const elem = elementsData.find(e => e.id == elemId);

            const text = `COURSE SYLLABUS MODULE: HIGH-IMPACT PRACTICE IMPLEMENTATION\n` +
                         `Quality Element: ${elem.name}\n` +
                         `Target Level: ${level}\n` +
                         `Track Focus: ${track}\n` +
                         `Mapped Texas A&M ULOs: ${elem.ulo.join(', ')}\n\n` +
                         `COURSE POLICY STATEMENT:\n` +
                         `"In accordance with Texas A&M's commitment to high-impact learning, this course embeds structured ${elem.name.toLowerCase()} at the ${level} level. Students will engage in ${level.toLowerCase()}-level activities designed to foster ${elem.ulo.join(' and ')}, ensuring direct application of course concepts to professional and real-world contexts."`;

            document.getElementById('syllabus-output').innerText = text;
        }

        function copySyllabusText() {
            const text = document.getElementById('syllabus-output').innerText;
            navigator.clipboard.writeText(text);
            alert("Syllabus language copied to clipboard!");
        }

        // Render Phase 2 Accordion
        function renderScaffoldingAccordion() {
            const container = document.getElementById('scaffolding-accordion');
            container.innerHTML = scaffoldingData.map((item, idx) => `
                <div class="border border-slate-200 rounded-lg overflow-hidden bg-white shadow-sm">
                    <button onclick="toggleAccordion(${idx})" class="w-full text-left p-4 bg-slate-50 hover:bg-slate-100 flex justify-between items-center transition">
                        <span class="font-bold text-slate-800 text-sm">${item.element}</span>
                        <i data-lucide="chevron-down" id="acc-icon-${idx}" class="w-4 h-4 text-slate-500 transition-transform"></i>
                    </button>
                    <div id="acc-content-${idx}" class="hidden p-4 space-y-3 text-xs border-t border-slate-200">
                        <div class="p-3 bg-red-50 border-l-4 border-red-500 text-red-900 rounded-r">
                            <strong class="font-bold uppercase text-[10px] tracking-wider block mb-0.5 text-red-700">Common Execution Pitfall</strong>
                            ${item.pitfall}
                        </div>
                        <div class="p-3 bg-emerald-50 border-l-4 border-emerald-500 text-emerald-900 rounded-r">
                            <strong class="font-bold uppercase text-[10px] tracking-wider block mb-0.5 text-emerald-700">Actionable Scaffolding Solution</strong>
                            ${item.solution}
                        </div>
                        <div class="p-3 bg-blue-50 border-l-4 border-blue-500 text-blue-900 rounded-r">
                            <strong class="font-bold uppercase text-[10px] tracking-wider block mb-0.5 text-blue-700">Equity & Inclusion Lens</strong>
                            ${item.equity}
                        </div>
                    </div>
                </div>
            `).join('');
            lucide.createIcons();
        }

        function toggleAccordion(idx) {
            const content = document.getElementById(`acc-content-${idx}`);
            const icon = document.getElementById(`acc-icon-${idx}`);
            if(content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                icon.style.transform = "rotate(180deg)";
            } else {
                content.classList.add('hidden');
                icon.style.transform = "rotate(0deg)";
            }
        }

        // Update Report View (Phase 1)
        function updateReportView() {
            const total = Object.values(diagnosticScores).reduce((a, b) => a + b, 0);
            document.getElementById('report-score-display').innerText = `${total} / 24 Points`;

            const activeUlos = new Set();
            elementsData.forEach(el => {
                if(diagnosticScores[el.id] > 0) {
                    el.ulo.forEach(u => activeUlos.add(u));
                }
            });

            document.getElementById('report-ulo-list').innerHTML = Array.from(activeUlos).map(u => 
                `<span class="bg-tamu-maroon text-white text-[10px] font-bold px-2 py-0.5 rounded">${u}</span>`
            ).join('') || '<span class="text-xs text-slate-400">None mapped yet</span>';

            const grid = document.getElementById('report-element-grid');
            grid.innerHTML = elementsData.map(el => {
                const score = diagnosticScores[el.id] || 0;
                const status = score === 3 ? "Integrated" : score === 2 ? "Applied" : score === 1 ? "Foundational" : "Not Present";
                const badgeColor = score > 0 ? "bg-emerald-100 text-emerald-800" : "bg-slate-100 text-slate-500";
                return `
                    <div class="p-3 border rounded border-slate-200 flex justify-between items-center bg-slate-50">
                        <div>
                            <div class="font-bold text-slate-800">${el.name}</div>
                            <div class="text-[10px] text-slate-500">${el.quad}</div>
                        </div>
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded ${badgeColor}">${status} (${score}/3)</span>
                    </div>
                `;
            }).join('');
        }
    </script>
</body>
</html>
