                curricular: "Defending whitepapers before municipal councils, professional conferences, or journals.",
                cocurricular: "National media feature or statewide science advocacy campaign leadership.",
                prompts: ["How does student work create lasting institutional or public policy utility?"],
                tweak: "Submit final student project reports directly to external agency leaders."
              }
            }
          }
        ]
      }
    ];

    function renderMatrix() {
      const container = document.getElementById("matrixContainer");
      container.innerHTML = "";

      // Column Headers
      container.innerHTML += `
        <div class="grid-header">AAC&U Quality Element</div>
        <div class="grid-header">
          FOUNDATIONAL
          <span class="score-tag">Target: 8-13 Pts | Scope 1 (Internal)</span>
        </div>
        <div class="grid-header">
          APPLIED
          <span class="score-tag">Target: 14-19 Pts | Scope 2 (Campus/Community)</span>
        </div>
        <div class="grid-header">
          INTEGRATED
          <span class="score-tag">Target: 20-24 Pts | Scope 3 (External/Professional)</span>
        </div>
      `;

      matrixData.forEach(q => {
        // Quadrant Row Banner
        const qHeader = document.createElement("div");
        qHeader.className = "quadrant-row-header";
        qHeader.innerText = q.quadrant;
        container.appendChild(qHeader);

        q.elements.forEach(elem => {
          // Element Title Cell
          const titleCell = document.createElement("div");
          titleCell.className = "element-title-cell";
          titleCell.innerHTML = `
            <h3>${elem.title}</h3>
            <p>${elem.rationale}</p>
          `;
          container.appendChild(titleCell);

          // Render 3 Tier Cells
          ["foundational", "applied", "integrated"].forEach(tierKey => {
            const tierData = elem.tiers[tierKey];
            const cell = document.createElement("div");
            cell.className = "matrix-cell";
            cell.innerHTML = `
              <div class="cell-text">${tierData.desc}</div>
              <span class="cell-badge badge-cte">🛠️ ${elem.cteTool}</span>
            `;
            cell.onclick = () => openModal(elem, tierKey);
            container.appendChild(cell);
          });
        });
      });
    }

    function openModal(elem, tierKey) {
      const tier = elem.tiers[tierKey];
      document.getElementById("modalTitle").innerText = `${elem.title} (${tierKey.toUpperCase()})`;
      document.getElementById("modalSubtitle").innerText = tier.target;
      document.getElementById("modalRationale").innerHTML = `<strong>Institutional Rationale:</strong> ${elem.rationale}`;
      document.getElementById("modalCurricular").innerText = tier.curricular;
      document.getElementById("modalCoCurricular").innerText = tier.cocurricular;
      
      document.getElementById("modalCteTitle").innerText = `Embedded CTE Diagnostic: ${elem.cteTool}`;
      const promptsList = document.getElementById("modalCtePrompts");
      promptsList.innerHTML = tier.prompts.map(p => `<li>${p}</li>`).join("");

      document.getElementById("modalMicroTweak").innerText = tier.tweak;

      document.getElementById("modalOverlay").classList.add("active");
    }

    function closeModal() {
      document.getElementById("modalOverlay").classList.remove("active");
    }

    function switchTier(mode) {
      // Future expansion toggle handler
    }

    // Initial load
    renderMatrix();
  </script>
</body>
</html>
