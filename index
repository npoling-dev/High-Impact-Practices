      let html = `
        <div class="grid-header">AAC&U Quality Element</div>
        <div class="grid-header">FOUNDATIONAL<span class="score-tag">Scope 1 (Classroom)</span></div>
        <div class="grid-header">APPLIED<span class="score-tag">Scope 2 (Campus/Community)</span></div>
        <div class="grid-header">INTEGRATED<span class="score-tag">Scope 3 (Professional)</span></div>
      `;

      matrixData.forEach((q, qIndex) => {
        html += `<div class="quadrant-row-header">${q.quadrant}</div>`;

        q.elements.forEach((elem, eIndex) => {
          html += `
            <div class="element-title-cell">
              <h3>${elem.title}</h3>
              <p>${elem.rationale}</p>
            </div>
          `;

          ["foundational", "applied", "integrated"].forEach(tierKey => {
            const tierData = elem.tiers[tierKey];
            html += `
              <div class="matrix-cell" onclick="openModal(${qIndex}, ${eIndex}, '${tierKey}')">
                <div class="cell-text">${tierData.desc}</div>
                <div class="cell-action">Click for 9 Exemplars ➔</div>
              </div>
            `;
          });
        });
      });

      container.innerHTML = html;
    }

    function openModal(qIndex, eIndex, tierKey) {
      const elem = matrixData[qIndex].elements[eIndex];
      const tier = elem.tiers[tierKey];

      document.getElementById("modalTitle").innerText = `${elem.title}`;
      document.getElementById("modalSubtitle").innerText = tier.scope;

      renderExampleList("outcomesContainer", tier.outcomes);
      renderExampleList("activitiesContainer", tier.activities);
      renderExampleList("assessmentsContainer", tier.assessments);

      document.getElementById("modalOverlay").classList.add("active");
    }

    function renderExampleList(containerId, items) {
      const container = document.getElementById(containerId);
      container.innerHTML = items.map(item => {
        let badgeClass = "stem";
        if (item.tag.includes("Humanities") || item.tag.includes("Psychology") || item.tag.includes("Sociology") || item.tag.includes("English") || item.tag.includes("History") || item.tag.includes("Education") || item.tag.includes("Political Science") || item.tag.includes("Communication") || item.tag.includes("Visual Arts") || item.tag.includes("Anthropology") || item.tag.includes("International")) {
          badgeClass = "humanities";
        } else if (item.tag.includes("Business") || item.tag.includes("DEEP") || item.tag.includes("Co-Curricular")) {
          badgeClass = "business";
        }

        return `
          <div class="example-card">
            <span class="discipline-badge ${badgeClass}">${item.tag}</span>
            <div class="example-text">${item.text}</div>
          </div>
        `;
      }).join("");
    }

    function closeModal() {
      document.getElementById("modalOverlay").classList.remove("active");
    }

    function handleOverlayClick(event) {
      if (event.target.id === "modalOverlay") {
        closeModal();
      }
    }

    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape") {
        closeModal();
      }
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", renderMatrix);
    } else {
      renderMatrix();
    }
  </script>
</body>
</html>
