<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TAMU HIPs Interactive Course Profile & Design Matrix</title>
  <style>
    :root {
      --tamu-maroon: #500000;
      --tamu-dark-maroon: #3c0000;
      --tamu-gray: #333333;
      --tamu-light-bg: #f8f9fa;
      --tamu-card-border: #e2e8f0;
      --tamu-accent-gold: #d4af37;
      --tamu-blue-accent: #1e3a8a;
      --tamu-green-accent: #065f46;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: #f4f6f8;
      color: var(--tamu-gray);
      line-height: 1.5;
      padding: 24px;
    }

    header {
      background-color: var(--tamu-maroon);
      color: white;
      padding: 24px 32px;
      border-radius: 8px;
      margin-bottom: 24px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    header h1 {
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }

    header p {
      font-size: 0.95rem;
      opacity: 0.9;
    }

    .controls-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: white;
      padding: 16px 24px;
      border-radius: 8px;
      margin-bottom: 24px;
      border: 1px solid var(--tamu-card-border);
    }

    .toggle-group {
      display: flex;
      gap: 8px;
    }

    .toggle-btn {
      background: var(--tamu-light-bg);
      border: 1px solid var(--tamu-card-border);
      padding: 8px 16px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .toggle-btn.active {
      background: var(--tamu-maroon);
      color: white;
      border-color: var(--tamu-maroon);
    }

    .matrix-grid {
      display: grid;
      grid-template-columns: 240px repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 32px;
    }

    .grid-header {
      background: #e2e8f0;
      padding: 14px;
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-radius: 6px;
      color: var(--tamu-gray);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .grid-header .score-tag {
      font-size: 0.75rem;
      font-weight: 500;
      color: #475569;
      margin-top: 4px;
      text-transform: none;
    }

    .quadrant-row-header {
      grid-column: span 4;
      background: var(--tamu-dark-maroon);
      color: white;
      padding: 10px 16px;
      font-weight: 700;
      font-size: 0.9rem;
      border-radius: 6px;
      letter-spacing: 0.03em;
      margin-top: 8px;
    }

    .element-title-cell {
      background: white;
      padding: 16px;
      border-radius: 6px;
      border-left: 4px solid var(--tamu-maroon);
      border: 1px solid var(--tamu-card-border);
      border-left-width: 5px;
    }

    .element-title-cell h3 {
      font-size: 0.95rem;
      color: var(--tamu-maroon);
      margin-bottom: 6px;
    }

    .element-title-cell p {
      font-size: 0.78rem;
      color: #64748b;
    }

    .matrix-cell {
      background: white;
      padding: 16px;
      border-radius: 6px;
      border: 1px solid var(--tamu-card-border);
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .matrix-cell:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      border-color: var(--tamu-maroon);
    }

    .cell-text {
      font-size: 0.85rem;
      color: var(--tamu-gray);
      margin-bottom: 12px;
    }

    .cell-badge {
      display: inline-block;
      align-self: flex-start;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 4px;
      background: #f1f5f9;
      color: #334155;
    }

    .badge-cte {
      background: #eff6ff;
      color: var(--tamu-blue-accent);
      border: 1px solid #bfdbfe;
    }

    /* Modal Overlay */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(4px);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 1000;
      padding: 20px;
    }

    .modal-overlay.active {
      display: flex;
    }

    .modal-content {
      background: white;
      width: 100%;
      max-width: 820px;
      max-height: 90vh;
      border-radius: 12px;
      overflow-y: auto;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
      position: relative;
    }

    .modal-header {
      background: var(--tamu-maroon);
      color: white;
      padding: 24px;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .modal-header h2 {
      font-size: 1.3rem;
      margin-bottom: 4px;
    }

    .modal-header p {
      font-size: 0.85rem;
      opacity: 0.9;
    }

    .close-btn {
      position: absolute;
      top: 20px;
      right: 24px;
      background: rgba(255, 255, 255, 0.2);
      color: white;
      border: none;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      font-size: 1.2rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .close-btn:hover {
      background: rgba(255, 255, 255, 0.4);
    }

    .modal-body {
      padding: 24px;
    }

    .rationale-box {
      background: #fffbe3;
      border-left: 4px solid var(--tamu-accent-gold);
      padding: 12px 16px;
      border-radius: 4px;
      font-size: 0.85rem;
      margin-bottom: 20px;
    }

    .track-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }

    .track-card {
      background: var(--tamu-light-bg);
      border: 1px solid var(--tamu-card-border);
      border-radius: 8px;
      padding: 16px;
    }

    .track-card.curricular {
      border-top: 4px solid var(--tamu-blue-accent);
    }

    .track-card.cocurricular {
      border-top: 4px solid var(--tamu-green-accent);
    }

    .track-card h4 {
      font-size: 0.9rem;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .track-card p {
      font-size: 0.82rem;
      color: #475569;
    }

    .cte-tool-container {
      background: #f0f9ff;
      border: 1px solid #bae6fd;
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 20px;
    }

    .cte-tool-container h3 {
      font-size: 1rem;
      color: #0369a1;
      margin-bottom: 12px;
    }

    .prompt-list {
      list-style: none;
    }

    .prompt-list li {
      font-size: 0.85rem;
      margin-bottom: 8px;
      padding-left: 20px;
      position: relative;
    }

    .prompt-list li::before {
      content: "▶";
      position: absolute;
      left: 0;
      color: #0284c7;
      font-size: 0.7rem;
      top: 3px;
    }

    .micro-tweak-box {
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      padding: 16px;
      border-radius: 8px;
    }

    .micro-tweak-box h4 {
      font-size: 0.85rem;
      color: #334155;
      margin-bottom: 6px;
    }

    .micro-tweak-box p {
      font-size: 0.8rem;
      color: #64748b;
    }
  </style>
</head>
<body>

  <header>
    <h1>TAMU High-Impact Practices (HIPs) Interactive Course Profile</h1>
    <p>Center for Teaching Excellence | Texas A&M University</p>
  </header>

  <div class="controls-bar">
    <div>
      <strong>Framework Navigation Mode:</strong>
    </div>
    <div class="toggle-group">
      <button class="toggle-btn active" id="btn-3tier" onclick="switchTier('3tier')">3-Tier Fidelity View (Foundational / Applied / Integrated)</button>
    </div>
  </div>

  <main class="matrix-grid" id="matrixContainer">
    <!-- Rendered via JS -->
  </main>

  <!-- Modal -->
  <div class="modal-overlay" id="modalOverlay">
    <div class="modal-content">
      <div class="modal-header">
        <button class="close-btn" onclick="closeModal()">&times;</button>
        <h2 id="modalTitle">Element Title</h2>
        <p id="modalSubtitle">Quadrant & Fidelity Level</p>
      </div>
      <div class="modal-body">
        <div class="rationale-box" id="modalRationale"></div>

        <div class="track-grid">
          <div class="track-card curricular">
            <h4>📘 Academic / Curricular Track</h4>
            <p id="modalCurricular"></p>
          </div>
          <div class="track-card cocurricular">
            <h4>🚀 Co-Curricular Track (DEEP / Outreach)</h4>
