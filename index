<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TAMU High-Impact Practices (HIPs) Interactive Course Profile</title>
  <style>
    :root {
      --tamu-maroon: #500000;
      --tamu-dark-maroon: #3c0000;
      --tamu-gray: #333333;
      --tamu-light-bg: #f8f9fa;
      --tamu-card-border: #e2e8f0;
      --tamu-accent-gold: #d4af37;
      --tamu-blue-accent: #1e3a8a;
      --tamu-green-accent: #065f46;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: #f4f6f8;
      color: var(--tamu-gray);
      line-height: 1.5;
      padding: 24px;
    }

    header {
      background-color: var(--tamu-maroon);
      color: white;
      padding: 24px 32px;
      border-radius: 8px;
      margin-bottom: 24px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    header h1 {
      font-size: 1.8rem;
      font-weight: 700;
      margin-bottom: 6px;
    }

    header p {
      font-size: 0.95rem;
      opacity: 0.9;
    }

    .matrix-grid {
      display: grid;
      grid-template-columns: 240px repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 32px;
    }

    .grid-header {
      background: #e2e8f0;
      padding: 14px;
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      border-radius: 6px;
      color: var(--tamu-gray);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .grid-header .score-tag {
      font-size: 0.75rem;
      font-weight: 500;
      color: #475569;
      margin-top: 4px;
      text-transform: none;
    }

    .quadrant-row-header {
      grid-column: span 4;
      background: var(--tamu-dark-maroon);
      color: white;
      padding: 10px 16px;
      font-weight: 700;
      font-size: 0.9rem;
      border-radius: 6px;
      margin-top: 8px;
    }

    .element-title-cell {
      background: white;
      padding: 16px;
      border-radius: 6px;
      border: 1px solid var(--tamu-card-border);
      border-left: 5px solid var(--tamu-maroon);
    }

    .element-title-cell h3 {
      font-size: 0.95rem;
      color: var(--tamu-maroon);
      margin-bottom: 6px;
    }

    .element-title-cell p {
      font-size: 0.78rem;
      color: #64748b;
    }

    .matrix-cell {
      background: white;
      padding: 16px;
      border-radius: 6px;
      border: 1px solid var(--tamu-card-border);
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .matrix-cell:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      border-color: var(--tamu-maroon);
    }

    .cell-text {
      font-size: 0.85rem;
      color: var(--tamu-gray);
      margin-bottom: 12px;
    }

    .cell-badge {
      display: inline-block;
      align-self: flex-start;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 4px;
      background: #eff6ff;
      color: var(--tamu-blue-accent);
      border: 1px solid #bfdbfe;
    }

    /* Modal Overlay */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(4px);
      display: none; /* Crucial: Keeps modal hidden until clicked */
      justify-content: center;
      align-items: center;
      z-index: 1000;
      padding: 20px;
    }

    .modal-overlay.active {
      display: flex !important;
    }

    .modal-content {
      background: white;
      width: 100%;
      max-width: 820px;
      max-height: 90vh;
      border-radius: 12px;
      overflow-y: auto;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
      position: relative;
    }

    .modal-header {
      background: var(--tamu-maroon);
      color: white;
      padding: 24px;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .modal-header h2 {
      font-size: 1.3rem;
      margin-bottom: 4px;
    }

    .modal-header p {
      font-size: 0.85rem;
      opacity: 0.9;
    }

    .close-btn {
      position: absolute;
      top: 20px;
      right: 24px;
      background: rgba(255, 255, 255, 0.2);
      color: white;
      border: none;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      font-size: 1.2rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .close-btn:hover {
      background: rgba(255, 255, 255, 0.4);
    }

    .modal-body {
      padding: 24px;
    }

    .rationale-box {
      background: #fffbe3;
      border-left: 4px solid var(--tamu-accent-gold);
      padding: 12px 16px;
      border-radius: 4px;
      font-size: 0.85rem;
      margin-bottom: 20px;
    }

    .track-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }

    .track-card {
      background: var(--tamu-light-bg);
      border: 1px solid var(--tamu-card-border);
      border-radius: 8px;
      padding: 16px;
    }

    .track-card.curricular {
      border-top: 4px solid var(--tamu-blue-accent);
    }

    .track-card.cocurricular {
      border-top: 4px solid var(--tamu-green-accent);
    }

    .track-card h4 {
      font-size: 0.9rem;
      margin-bottom: 8px;
    }

    .track-card p {
      font-size: 0.82rem;
      color: #475569;
    }

    .cte-tool-container {
      background: #f0f9ff;
      border: 1px solid #bae6fd;
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 20px;
    }

    .cte-tool-container h3 {
      font-size: 1rem;
      color: #0369a1;
      margin-bottom: 12px;
    }

    .prompt-list {
      list-style: none;
    }

    .prompt-list li {
      font-size: 0.85rem;
      margin-bottom: 8px;
      padding-left: 20px;
      position: relative;
    }

    .prompt-list li::before {
      content: "▶";
      position: absolute;
      left: 0;
      color: #0284c7;
      font-size: 0.7rem;
      top: 3px;
    }

    .micro-tweak-box {
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      padding: 16px;
      border-radius: 8px;
    }

    .micro-tweak-box h4 {
      font-size: 0.85rem;
      color: #334155;
      margin-bottom: 6px;
    }

    .micro-tweak-box p {
      font-size: 0.8rem;
      color: #64748b;
    }
  </style>
</head>
<body>

  <header>
    <h1>TAMU High-Impact Practices (HIPs) Interactive Course Profile</h1>
    <p>Center for Teaching Excellence | Texas A&M University</p>
  </header>

  <main class="matrix-grid" id="matrixContainer">
    <!-- Rendered via JS -->
  </main>

  <!-- Modal -->
  <div class="modal-overlay" id="modalOverlay">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close-btn" onclick="closeModal()">&times;</button>
        <h2 id="modalTitle">Element Title</h2>
        <p id="modalSubtitle">Quadrant & Fidelity Level</p>
      </div>
      <div class="modal-body">
        <div class="rationale-box" id="modalRationale"></div>

        <div class="track-grid">
          <div class="track-card curricular">
            <h4>📘 Academic / Curricular Track</h4>
            <p id="modalCurricular"></p>
          </div>
          <div class="track-card cocurricular">
            <h4>🚀 Co-Curricular Track (DEEP / Outreach)</h4>
            <p id="modalCoCurricular"></p>
          </div>
        </div>

        <div class="cte-tool-container" id="modalCteBox">
          <h3 id="modalCteTitle">Embedded CTE Diagnostic Worksheet</h3>
          <ul class="prompt-list" id="modalCtePrompts"></ul>
        </div>

        <div class="micro-tweak-box">
          <h4>Subtractive Innovation: Low-Overhead Micro-Tweak</h4>
          <p id="modalMicroTweak"></p>
        </div>
      </div>
    </div>
  </div>

  <script>
    const matrixData = [
      {
        quadrant: "QUADRANT A: STRUCTURAL DESIGN & RIGOR",
        elements: [
          {
            id: "perf_exp",
            title: "Performance Expectations",
            rationale: "Audit Defense: Prevents 'HIP-in-name-only' reporting. High expectations ensure TAMU degree value.",
            cteTool: "Higher Impact Practice Audit (Grid)",
            tiers: {
              foundational: {
                target: "Target Score: 8-13 Points | Scope 1 (Internal)",
                desc: "Students identify and follow modeled professional standards to complete structured tasks.",
                curricular: "Students execute problem sets adhering strictly to field formatting and integrity protocols defined in syllabus.",
                cocurricular: "DEEP student volunteers follow established event setup and safety guidelines for demonstration tables.",
                prompts: [
                  "Where do students hit an early wall on quality standards?",
                  "What single checklist item de-risks initial submission errors?"
                ],
                tweak: "Add a 5-point peer-checklist before initial submission to filter out standard formatting errors."
              },
              applied: {
                target: "Target Score: 14-19 Points | Scope 2 (Campus/Community)",
                desc: "Students apply standards to solve semi-structured problems with increasing autonomy.",
                curricular: "Students complete a term project addressing an authentic client case, managing internal team milestones.",
                cocurricular: "DEEP student leads design and test a novel physics demonstration for the Physics & Engineering Festival.",
                prompts: [
                  "Identify a specific threshold concept or data hurdle in mid-stage execution.",
                  "Draft a rubric criterion focused on adaptive problem solving under semi-structured conditions."
                ],
                tweak: "Require students to submit a 1-page milestone progress audit halfway through the project timeline."
              },
              integrated: {
                target: "Target Score: 20-24 Points | Scope 3 (External/Professional)",
                desc: "Students negotiate and define criteria for original, unscripted outcomes.",
                curricular: "Students co-create project deliverables with external industry partners, defending choices before external reviewers.",
                cocurricular: "Student coordinators manage university-wide festival logistics and oversee external partner relationships.",
                prompts: [
                  "How do students self-assess professional agency during unscripted ambiguity?",
                  "What safety/liability agreements ground the external deliverable?"
                ],
                tweak: "Replace final internal exam with an open defense panel featuring external professional stakeholders."
              }
            }
          },
          {
            id: "time_effort",
            title: "Time & Effort",
            rationale: "Retention Math: Direct correlation between time on task in HIPs and student retention rates.",
            cteTool: "Higher Impact Practice Audit (Grid)",
            tiers: {
              foundational: {
                target: "Target Score: 8-13 Points | Scope 1 (Internal)",
                desc: "Consistent engagement over a term (<20 hrs); focus on workflow habits.",
                curricular: "Regular weekly 2-hour lab sessions dedicated to skill-building and guided practice.",
                cocurricular: "Attending bi-weekly DEEP planning workshops to prepare outreach activities.",
                prompts: ["How do we measure consistent weekly workflow without inflating grading workload?"],
                tweak: "Convert passive homework into active 15-minute weekly pre-lab check-in logs."
              },
              applied: {
                target: "Target Score: 14-19 Points | Scope 2 (Campus/Community)",
                desc: "Sustained intensity; significant out-of-class time (40-80 hrs) on iterative work.",
                curricular: "Semester-long CURE lab or capstone project requiring independent data collection.",
                cocurricular: "Leading a multi-month demonstration team preparing major public exhibits.",
                prompts: ["Where do time-management bottlenecks occur between weeks 6 and 10?"],
                tweak: "Implement sprint-style bi-weekly check-ins evaluated on pass/fail effort logs."
              },
              integrated: {
                target: "Target Score: 20-24 Points | Scope 3 (External/Professional)",
                desc: "Deep, immersive investment (100+ hrs); managing complex timelines.",
                curricular: "Multi-semester research thesis or immersive industry co-op.",
                cocurricular: "Executive leadership role overseeing year-round TAMU outreach programs.",
                prompts: ["How do students document agility when managing shifting project deadlines?"],
                tweak: "Use shared digital kanban boards (e.g., Trello/GitHub Project) to track time commitments."
              }
            }
          }
        ]
      },
      {
        quadrant: "QUADRANT B: INTERACTION & ENGAGEMENT",
        elements: [
          {
            id: "interactions",
            title: "Interactions (Faculty/Peer)",
            rationale: "Social Capital ROI: Density of mentorship predicts alumni engagement and post-grad success.",
            cteTool: "Small Group Work Audit",
            tiers: {
              foundational: {
                target: "Target Score: 8-13 Points | Scope 1 (Internal)",
                desc: "Faculty-led modeling; peers provide introductory feedback based on checklists.",
                curricular: "Structured peer review of draft essay introduction using explicit rubric.",
                cocurricular: "Peer feedback during initial DEEP demonstration rehearsals.",
                prompts: [
                  "Where does administrative team friction usually start?",
                  "Establish a simple Team Charter for communication norms."
                ],
                tweak: "Require group members to sign a 1-page Team Charter during week 2."
              },
              applied: {
                target: "Target Score: 14-19 Points | Scope 2 (Campus/Community)",
                desc: "Iterative collaboration; peers give formative critique; faculty acts as Consultant.",
                curricular: "Small team capstone project with weekly peer-critique logs and instructor consultations.",
                cocurricular: "Cross-disciplinary student teams co-designing interactive festival booths.",
                prompts: [
                  "Implement a Student-Led Escalation Protocol.",
                  "Grade charters complete/incomplete to save grading time."
                ],
                tweak: "Adopt a 3-step internal conflict escalation protocol before instructor intervenes."
              },
              integrated: {
                target: "Target Score: 20-24 Points | Scope 3 (External/Professional)",
                desc: "Sustained partnership; co-authoring or co-designing final products with partners.",
                curricular: "Co-authoring a peer-reviewed publication or patent application with faculty mentor.",
                cocurricular: "Joint leadership between senior student mentors and faculty chairs to run university events.",
                prompts: ["How do student leaders model inclusive decision-making during high-stakes events?"],
                tweak: "Structure student leadership roles as formal peer-mentorship apprenticeships."
              }
            }
          }
        ]
      },
      {
        quadrant: "QUADRANT C: FEEDBACK & REFINEMENT",
        elements: [
          {
            id: "reflection",
            title: "Structured Reflection",
            rationale: "The Learning Engine: Converts activity into portable skills. Prevents lost impact.",
            cteTool: "Metacognitive Prompt Designer",
            tiers: {
              foundational: {
                target: "Target Score: 8-13 Points | Scope 1 (Internal)",
                desc: "Descriptive: How does this experience match classroom learning?",
                curricular: "Short post-assignment journal: What concept was most challenging and why?",
                cocurricular: "Debrief log: What went as expected during the school demonstration?",
                prompts: [
                  "Where did you hit a wall in this module?",
                  "At this stage, what do I understand vs what remains unclear?"
                ],
                tweak: "Embed a 3-question prompt stem directly into Canvas submission pages."
              },
              applied: {
                target: "Target Score: 14-19 Points | Scope 2 (Campus/Community)",
                desc: "Integrative: How am I adapting my skills to meet specific context needs?",
                curricular: "Mid-semester synthesis paper evaluating theoretical predictions against lab anomalies.",
                cocurricular: "Leader reflection analyzing how communication was adapted for K-12 students.",
                prompts: [
                  "What approaches did I attempt? What failed and why?",
                  "What specific strategy will I adjust next phase?"
                ],
                tweak: "Replace summary conclusion with a formal Process Audit & Pivot Memo."
              },
              integrated: {
                target: "Target Score: 20-24 Points | Scope 3 (External/Professional)",
                desc: "Metacognitive: How has this partnership redefined my professional identity?",
                curricular: "E-portfolio reflecting on professional growth, ethics, and career alignment across full program.",
                cocurricular: "Comprehensive exit defense detailing leadership evolution and civic agency.",
                prompts: [
                  "How has navigating unscripted friction redefined your professional ethics?",
                  "What portable competencies will you articulate to future employers?"
                ],
                tweak: "Require an overarching synthetic narrative statement in the final portfolio."
              }
            }
          }
        ]
      }
    ];

    function renderMatrix() {
      const container = document.getElementById("matrixContainer");
      if (!container) return;
      container.innerHTML = "";

      container.innerHTML += `
        <div class="grid-header">AAC&U Quality Element</div>
        <div class="grid-header">FOUNDATIONAL<span class="score-tag">Score: 8-13 Pts | Scope 1</span></div>
        <div class="grid-header">APPLIED<span class="score-tag">Score: 14-19 Pts | Scope 2</span></div>
        <div class="grid-header">INTEGRATED<span class="score-tag">Score: 20-24 Pts | Scope 3</span></div>
      `;

      matrixData.forEach(q => {
        const qHeader = document.createElement("div");
        qHeader.className = "quadrant-row-header";
        qHeader.innerText = q.quadrant;
        container.appendChild(qHeader);

        q.elements.forEach(elem => {
          const titleCell = document.createElement("div");
          titleCell.className = "element-title-cell";
          titleCell.innerHTML = `<h3>${elem.title}</h3><p>${elem.rationale}</p>`;
          container.appendChild(titleCell);

          ["foundational", "applied", "integrated"].forEach(tierKey => {
            const tierData = elem.tiers[tierKey];
            const cell = document.createElement("div");
            cell.className = "matrix-cell";
            cell.innerHTML = `
              <div class="cell-text">${tierData.desc}</div>
              <span class="cell-badge">🛠️ ${elem.cteTool}</span>
            `;
            cell.onclick = () => openModal(elem, tierKey);
            container.appendChild(cell);
          });
        });
      });
    }

    function openModal(elem, tierKey) {
      const tier = elem.tiers[tierKey];
      document.getElementById("modalTitle").innerText = `${elem.title} (${tierKey.toUpperCase()})`;
      document.getElementById("modalSubtitle").innerText = tier.target;
      document.getElementById("modalRationale").innerHTML = `<strong>Institutional Rationale:</strong> ${elem.rationale}`;
      document.getElementById("modalCurricular").innerText = tier.curricular;
      document.getElementById("modalCoCurricular").innerText = tier.cocurricular;
      
      document.getElementById("modalCteTitle").innerText = `Embedded CTE Diagnostic: ${elem.cteTool}`;
      const promptsList = document.getElementById("modalCtePrompts");
      promptsList.innerHTML = tier.prompts.map(p => `<li>${p}</li>`).join("");

      document.getElementById("modalMicroTweak").innerText = tier.tweak;

      document.getElementById("modalOverlay").classList.add("active");
    }

    function closeModal() {
      document.getElementById("modalOverlay").classList.remove("active");
    }

    document.addEventListener("DOMContentLoaded", renderMatrix);
  </script>
</body>
</html>
