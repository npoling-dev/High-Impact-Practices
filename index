    function renderMatrix() {
      const container = document.getElementById("matrixContainer");
      if (!container) return;

      let html = `
        <div class="grid-header">AAC&U Quality Element</div>
        <div class="grid-header">FOUNDATIONAL<span class="score-tag">Scope 1 (Classroom - 8-13 pts)</span></div>
        <div class="grid-header">APPLIED<span class="score-tag">Scope 2 (Campus/Community - 14-19 pts)</span></div>
        <div class="grid-header">INTEGRATED<span class="score-tag">Scope 3 (External/Professional - 20-24 pts)</span></div>
      `;

      matrixData.forEach((q, qIndex) => {
        html += `<div class="quadrant-row-header">${q.quadrant}</div>`;

        q.elements.forEach((elem, eIndex) => {
          html += `
            <div class="element-title-cell">
              <h3>${elem.title}</h3>
              <p>${elem.rationale}</p>
            </div>
          `;

          ["foundational", "applied", "integrated"].forEach(tierKey => {
            const tierData = elem.tiers[tierKey];
            html += `
              <div class="matrix-cell" onclick="openModal(${qIndex}, ${eIndex}, '${tierKey}')">
                <div class="cell-text">${tierData.desc}</div>
                <div class="cell-action">Click for 3 Track Packages ➔</div>
              </div>
            `;
          });
        });
      });

      container.innerHTML = html;
    }

    function openModal(qIndex, eIndex, tierKey) {
      const elem = matrixData[qIndex].elements[eIndex];
      const tier = elem.tiers[tierKey];

      document.getElementById("modalTitle").innerText = `${elem.title}`;
      document.getElementById("modalSubtitle").innerText = `${matrixData[qIndex].quadrant} | ${tier.scope}`;

      const modalBody = document.getElementById("modalBody");
      
      modalBody.innerHTML = tier.exemplars.map(ex => `
        <div class="track-card ${ex.track}">
          <div class="track-header">
            <span class="track-badge ${ex.track}">${ex.trackLabel}</span>
            <span class="discipline-title">${ex.discipline}</span>
          </div>
          <div class="item-group">
            <div class="item-label">🎯 Learning Outcome</div>
            <div class="item-text">${ex.outcome}</div>
          </div>
          <div class="item-group">
            <div class="item-label">⚡ Learning Activity</div>
            <div class="item-text">${ex.activity}</div>
          </div>
          <div class="item-group">
            <div class="item-label">📊 Assessment & Artifact</div>
            <div class="item-text">${ex.assessment}</div>
          </div>
        </div>
      `).join("");

      document.getElementById("modalOverlay").classList.add("active");
    }

    function closeModal() {
      document.getElementById("modalOverlay").classList.remove("active");
    }

    function handleOverlayClick(event) {
      if (event.target.id === "modalOverlay") {
        closeModal();
      }
    }

    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape") {
        closeModal();
      }
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", renderMatrix);
    } else {
      renderMatrix();
    }
  </script>
